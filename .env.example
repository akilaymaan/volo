# ---- Required ----
# Claude (question generation, the live interviewer, scoring): https://console.anthropic.com
ANTHROPIC_API_KEY=
# Sarvam AI (speech-to-text + text-to-speech, 11 Indian languages): https://dashboard.sarvam.ai
SARVAM_API_KEY=
# Session signing secret. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the app (used for auth callbacks)
BETTER_AUTH_URL=http://localhost:3000

# ---- Database ----
# Leave empty to use the built-in embedded Postgres (stored in ./.data) — great for local use.
# For production/serverless set a Postgres URL (Supabase, Neon, RDS, ...).
DATABASE_URL=

# ---- Optional tuning ----
# CLAUDE_MODEL=claude-opus-5-5
# The live interviewer (fast model by default):
# CLAUDE_INTERVIEWER_MODEL=claude-haiku-5-5
# SARVAM_STT_MODEL=saaras:v4
# SARVAM_TTS_MODEL=bulbul:v3
# AI_MOCK=1   # fake AI + voice, for demos and the e2e test suite
