# ---- Required ----
# Claude (question generation, the live interviewer, scoring): https://console.anthropic.com
ANTHROPIC_API_KEY=
# Sarvam AI (speech-to-text + text-to-speech, 11 Indian languages): https://dashboard.sarvam.ai
SARVAM_API_KEY=
# Session signing secret. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Canonical app origin, not an API backend URL. Use HTTPS on Vercel/Render.
BETTER_AUTH_URL=http://localhost:3000

# ---- Database ----
# Explicit local development only. Set postgres on Vercel/Render.
DATABASE_MODE=pglite
# Runtime: Neon pooled URL. Migration process: direct Neon URL as DATABASE_URL.
# No separate direct-connection variable is read by the application.
# Use sslmode=verify-full. sslmode=require is upgraded to certificate-verifying TLS.
# channel_binding is unsupported by Postgres.js 3.4.9 and rejected, not silently ignored.
DATABASE_URL=
# Local mode requires an empty DATABASE_URL. Initialize with npm run db:local.
PGLITE_DIR=.data/pglite

# ---- Optional tuning ----
# CLAUDE_MODEL=claude-opus-5-5
# The live interviewer (fast model by default):
# CLAUDE_INTERVIEWER_MODEL=claude-haiku-5-5
# SARVAM_STT_MODEL=saaras:v4
# SARVAM_TTS_MODEL=bulbul:v3

# ---- Invitations ----
# Verify this sender/domain in Resend before sending real invitations.
RESEND_API_KEY=
EMAIL_FROM=

# ---- Retention ----
# Generate an independent random secret (at least 32 characters).
RETENTION_CRON_SECRET=
# Automatic cleanup is disabled until explicitly enabled. Test with dryRun first.
RETENTION_ENABLED=0

# ---- Cost estimates (optional; use your contracted USD rates) ----
# Keys must match the actual model ID returned by Anthropic.
# Values are USD per million input/output/cache tokens. Missing rates stay unpriced.
# ANTHROPIC_PRICING_JSON={"your-model-id":{"input":1,"output":1,"cacheRead":1,"cacheWrite":1}}
# SARVAM_TTS_USD_PER_MILLION_CHARACTERS=
# STT duration/cost is not currently priced; uploaded bytes and call counts are recorded.
